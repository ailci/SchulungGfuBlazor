@using Application.Utilities
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@inject ILogger<SystemInfo> Logger
@inject IJSRuntime JsRuntime

<div class="row">
    <div class="col">
        <div class="card" style="margin-top: 20px">
            <div class="card-header">SystemInfo</div>
            <div class="card-body">
                <div>
                    <strong>.NET:</strong> @System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription
                </div>
                <div>
                    <strong>Rechnername:</strong> @Environment.MachineName<br/>
                    <strong>Architektur:</strong> @System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture<br/>
                    <strong>OS:</strong> @Environment.OSVersion<br/>
                </div>
                <div>
                    <strong>Rendermodus:</strong> @RendererInfo.Name<br/>
                    <strong>Interaktiv:</strong> @RendererInfo.IsInteractive<br/>
                    <strong>Geplanter Rendermodus:</strong> @AssignedRenderMode?.ToString()<br/>
                    <strong>Ziel-Rendermodus erreicht:</strong> @AssignedRenderModeReached<br/>
                </div>

                <!-- Browser Info von JS -->
                @if (BrowserInfo.Any())
                {
                    <div class="mt-3">
                        <strong>Browser Info from JS</strong>
                    </div>
                    <div>
                        @foreach (var info in BrowserInfo)
                        {
                            <strong>@info.Key:</strong> @info.Value<br/>
                        }
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@code {
    private bool AssignedRenderModeReached => AssignedRenderMode switch
    {
        InteractiveServerRenderMode => RendererInfo is {
            Name: "Server", IsInteractive: true },
        InteractiveWebAssemblyRenderMode => RendererInfo.Name == "WebAssembly",
        InteractiveAutoRenderMode => RendererInfo.Name == "WebAssembly",
        _ => true
    };

    private IJSObjectReference _jsModule = null!;
    public Dictionary<string, string> BrowserInfo { get; set; } = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotNetObjRef = DotNetObjectReference.Create(this); //Componente als Referenz
            _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/UI.Blazor.ComponentsLibrary/Components/SystemInfo.razor.js");
            await _jsModule.InvokeVoidAsync("GetBrowserInfo", dotNetObjRef, nameof(SetBrowserInfo));
        }
    }

    [JSInvokable]
    public void SetBrowserInfo(Dictionary<string,string> info)
    {
        Logger.LogInformation("SetBrowserInfo aufgerufen...");
        BrowserInfo = info;
        Logger.LogInformation($"BrowserInfo: {BrowserInfo.LogAsJson()}");
        StateHasChanged();
    }
}
