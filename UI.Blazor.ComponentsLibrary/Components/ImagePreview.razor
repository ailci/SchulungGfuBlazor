@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.Formats
@using SixLabors.ImageSharp.PixelFormats
@using SixLabors.ImageSharp.Processing

@if (SelectedPhoto is not null && IsImage(SelectedPhoto))
{
    <div class="form-floating mb-3">
        <div class="row">
            <div class="col">
                <h5 class="fw-bold text-center">Bild Vorschau</h5>
            </div>
        </div>
        <div class="row">
            <div class="col-4">
                <img class="img-fluid" src="@_imageDataUrl" />
            </div>
            <div class="col-8">
                <table class="table table-striped table-responsive">
                    <thead>
                    <tr>
                        <th>Eigenschaft</th>
                        <th>Wert</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>Name</td>
                        <td>@SelectedPhoto.Name</td>
                    </tr>
                    <tr>
                        <td>Größe</td>
                        <td>@SelectedPhoto.Size</td>
                    </tr>
                    <tr>
                        <td>Type</td>
                        <td>@SelectedPhoto.ContentType</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IBrowserFile? SelectedPhoto { get; set; }
    private string _imageDataUrl = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if(SelectedPhoto is not null && IsImage(SelectedPhoto))
        {
            var resizedImage = await ResizeImageAsync(SelectedPhoto, 180, 180);
            _imageDataUrl = $"data:{SelectedPhoto.ContentType};base64,{Convert.ToBase64String(resizedImage)}";
        }
    }

    private async Task<byte[]> ResizeImageAsync(IBrowserFile imageFile, int width, int height)
    {
        await using var stream = imageFile.OpenReadStream();
        using var image = await Image.LoadAsync<Rgba32>(stream);
        image.Mutate(x => x.Resize(width, height));

        using var ms = new MemoryStream();
        await image.SaveAsync(ms, GetImageFormat(imageFile.ContentType));
        return ms.ToArray();
    }

    private IImageFormat GetImageFormat(string format)
    {
        return format.ToLower() switch
        {
            "image/jpeg" => SixLabors.ImageSharp.Formats.Jpeg.JpegFormat.Instance,
            "image/jpg" => SixLabors.ImageSharp.Formats.Jpeg.JpegFormat.Instance,
            "image/png" => SixLabors.ImageSharp.Formats.Png.PngFormat.Instance,
            "image/bmp" => SixLabors.ImageSharp.Formats.Bmp.BmpFormat.Instance,
            "image/gif" => SixLabors.ImageSharp.Formats.Gif.GifFormat.Instance,
            _ => SixLabors.ImageSharp.Formats.Png.PngFormat.Instance
        };
    }

    private bool IsImage(IBrowserFile file)
    {
        var imageMimeTypes = new[] { "image/jpeg", "image/jpg", "image/png", "image/bmp", "image/gif" };
        return imageMimeTypes.Contains(file.ContentType.ToLower());
    }
}
