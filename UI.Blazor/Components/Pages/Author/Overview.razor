@page "/authors/overview"

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div>
    <button class="btn btn-primary" @onclick="NavigateToAuthorNew"><i class="bi bi-plus-circle"></i> Neuer Autor</button>
</div>

@if (AuthorsVm is null || !AuthorsVm.Any())
{
    <div>Daten werden geladen...</div>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Photo</th>
                <th>Name</th>
                <th>Beschreibung</th>
                <th>Geburtsdatum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var author in AuthorsVm)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(author.PhotoMimeType) && author.Photo is not null)
                        {
                            <img width="100" src="data:@author.PhotoMimeType;base64,@Convert.ToBase64String(author.Photo)" alt="@author.Name" />
                        }
                        else
                        {
                            <img width="100" src="https://place-hold.it/150" alt="@author.Name" />
                        }
                    </td>
                    <td>@author.Name</td>
                    <td>@author.Description</td>
                    <td>@(author.BirthDate is not null ? author.BirthDate.Value.ToShortDateString() : "k.A.")</td>
                    <td>
                        <a href="@($"author/details/{author.Id}")" class="btn btn-info"><i class="bi bi-info-circle-fill"></i></a> |
                        <button type="button" class="btn btn-danger" @onclick="() => DeleteAuthor(author)"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}